# OAuth Client Credentials for Wixen Mail
#
# Copy this file to the settings folder as oauth.toml and fill in your
# credentials. On Windows that is:
#
#     %LOCALAPPDATA%\wixen-mail\config\oauth.toml
#
# Alternatively, set the environment variables listed below.
#
# DO NOT commit your actual credentials to the repository.
#
# ── Gmail ────────────────────────────────────────────────────────────────────
# Register at: https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (Desktop application type).
# Env vars: WIXEN_GMAIL_CLIENT_ID, WIXEN_GMAIL_CLIENT_SECRET
[gmail]
client_id = ""
client_secret = ""

# ── Microsoft / Outlook ──────────────────────────────────────────────────────
# Register at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# Create a new registration → Authentication → Add "Mobile and desktop" platform
# with redirect URI: http://localhost:8087/oauth/callback
# Env vars: WIXEN_OUTLOOK_CLIENT_ID, WIXEN_OUTLOOK_CLIENT_SECRET
[outlook]
client_id = ""
client_secret = ""

# ── Google Safe Browsing (optional) ──────────────────────────────────────────
# Only needed if you switch on "Check links against Google Safe Browsing" in
# Settings, Advanced. It is an ordinary API key rather than OAuth, so it does
# not involve Google's verification process.
#
# Get one at: https://console.cloud.google.com/apis/credentials
# Enable the "Safe Browsing API" for the project first.
# Env var: WIXEN_SAFE_BROWSING_KEY
#
# What this key is used for: downloading Google's public lists of known
# phishing and malware sites to this computer. Links are compared here. Your
# links are never sent. See docs/privacy.md.
[safe_browsing]
api_key = ""
